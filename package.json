{
  "name": "renewal-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @renewals/api\" \"npm run dev -w @renewals/web\"",
    "build": "npm run build -w @renewals/api && npm run build -w @renewals/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.checks.json",
    "lint": "eslint . && node scripts/check-fsd.mjs",
    "test": "tsx --test --test-concurrency=1 apps/api/test/*.test.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx --env-file-if-exists=.env apps/api/src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env apps/api/src/db/cli.ts seed",
    "start": "npm run start -w @renewals/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
