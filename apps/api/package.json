    "@fastify/rate-limit": "11.2.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/send": "4.2.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
